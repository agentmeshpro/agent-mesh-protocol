        "audience": "agent://registry.home.example.com",
        "issued_at": "2026-04-09T14:00:00Z",
        "nonce": "fed-nonce-01-k3Jp9wQz"
      },
      "sign": {
        "kind": "federation_trust_proof",
        "key": "ed25519-c"

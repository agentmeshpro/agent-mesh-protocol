      "expected_canonical": "{\"audience\":\"agent://registry.home.example.com\",\"capabilities\":[\"resolve\",\"search\"],\"issued_at\":\"2026-04-09T14:00:00Z\",\"nonce\":\"fed-nonce-01-k3Jp9wQz\",\"registry_id\":\"agent://registry.alpha.example.com\",\"type\":\"ampro.registry.federation_request.v1\"}"

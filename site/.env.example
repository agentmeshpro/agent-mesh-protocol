# Copy to .env.local for local development. Never commit real values.

# --- Required at request time (the build does not need them) ---------------

# Vercel AI Gateway credential. The demo calls models through the
# official AI SDK gateway (https://ai-gateway.vercel.sh), not a
# provider SDK of its own. Optional on Vercel: without a key the gateway
# authenticates with the project's OIDC token. Locally, either set a key
# or run `vercel env pull` to get VERCEL_OIDC_TOKEN (it expires after 12h).
AI_GATEWAY_API_KEY=

# Gateway model ids. Only these are ever used; clients cannot pick a model.
# Examples that match the demo's OpenAI voices (nova, shimmer, onyx):
AMP_DEMO_LANGUAGE_MODEL=openai/gpt-4o-mini
AMP_DEMO_SPEECH_MODEL=openai/tts-1
AMP_DEMO_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe

# --- Optional ----------------------------------------------------------------

# Derive the demo agents' Ed25519 keys from this secret so every server
# instance signs with the same keys. Recommended on Vercel. Long random value.
AMP_DEMO_SIGNING_SEED=

# Extra origins allowed to POST to the API (comma-separated). The site's own
# origin is always allowed.
AMP_DEMO_ALLOWED_ORIGINS=

# Abuse limits (defaults shown). Per server instance, best-effort.
# AMP_DEMO_RATE_BURST=8
# AMP_DEMO_RATE_PER_MINUTE=4
# AMP_DEMO_GLOBAL_PER_HOUR=400
# AMP_DEMO_MAX_CONCURRENT=16
# AMP_DEMO_MAX_MESSAGE_CHARS=1000
# AMP_DEMO_MAX_HISTORY_ENTRIES=40
# AMP_DEMO_MAX_HISTORY_ENTRY_CHARS=4000
# AMP_DEMO_HISTORY_TURNS_FOR_MODEL=16
# AMP_DEMO_MAX_JSON_BYTES=262144
# AMP_DEMO_MAX_AUDIO_BYTES=1048576
# AMP_DEMO_MAX_AUDIO_SECONDS=60
# AMP_DEMO_MAX_OUTPUT_TOKENS=500
# AMP_DEMO_MAX_SPEECH_CHARS=600
# AMP_DEMO_MODEL_TIMEOUT_MS=25000
# AMP_DEMO_REQUEST_TIMEOUT_MS=55000

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CatlystAI/agent-mesh-protocol/spec/schemas/stream/stream.channel_open.json",
  "title": "AMP stream event data: stream.channel_open",
  "description": "Event emitted when a new stream channel is opened.",
  "properties": {
    "channel_id": {
      "description": "Channel being opened",
      "title": "Channel Id",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Task this channel serves",
      "title": "Task Id"
    },
    "created_at": {
      "description": "ISO-8601 timestamp",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "channel_id",
    "created_at"
  ],
  "type": "object",
  "x-amp-event-type": "stream.channel_open"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentmeshpro/agent-mesh-protocol/spec/schemas/body/registry.federation_response.json",
  "title": "AMP body: registry.federation_response",
  "description": "Response to a registry federation request.",
  "properties": {
    "accepted": {
      "description": "Whether federation was accepted",
      "title": "Accepted",
      "type": "boolean"
    },
    "federation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Unique federation ID (required when accepted)",
      "title": "Federation Id"
    },
    "terms": {
      "additionalProperties": true,
      "description": "Federation terms (rate limits, retention, etc.)",
      "title": "Terms",
      "type": "object"
    }
  },
  "required": [
    "accepted"
  ],
  "type": "object",
  "x-amp-body-type": "registry.federation_response"
}

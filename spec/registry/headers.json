      "direction": "request",
      "format": "String",
      "description": "Hint for anonymous sender handling",
      "section": "14.2",
      "since": "0.1.2",
      "status": "stable"
    },
    {
      "name": "Authorization",
      "locations": [
        "envelope",
        "http"
      ],
      "group": "Core Headers",
      "direction": "request",
      "format": "Scheme + token",
      "description": "Authentication credentials",
      "section": "14.1",
      "since": "0.1.0",
      "status": "stable"
    },
    {
      "name": "Callback-Events",
      "locations": [
        "envelope"
      ],

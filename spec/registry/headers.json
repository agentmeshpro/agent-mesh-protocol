  "change_process": "GOVERNANCE.md; third-party registrations per docs/EXTENSIONS.md",
  "entries": [
    {
      "name": "Accept-Capabilities",
      "locations": [
        "envelope"
      ],
      "group": "Capability Negotiation Headers",
      "direction": "request",
      "format": "Comma-separated",
      "description": "Capabilities the client desires",
      "section": "14.4",
      "since": "0.1.0",
      "status": "stable"
    },
    {
      "name": "Accept-Language",
      "locations": [
        "envelope",
        "http"
      ],
      "group": "Messaging Control Headers",
      "direction": "request",
      "format": "BCP 47 tags",
      "description": "Client's preferred languages",
      "section": "14.5",
      "since": "0.1.0",
      "status": "stable"
    },
    {
      "name": "Accept-Version",
      "locations": [
        "envelope",
        "http"
      ],
      "group": "Core Headers",
      "direction": "request",
      "format": "Comma-separated semver",
      "description": "Client's preferred protocol versions",
      "section": "14.1",
      "since": "0.1.0",
      "status": "stable"
    },
    {

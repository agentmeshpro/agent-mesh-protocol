        "envelope"
      ],
      "group": "Messaging Control Headers",
      "direction": "request",
      "format": "HTTPS URL",
      "description": "URL for asynchronous result delivery",
      "section": "14.5",
      "since": "0.1.0",
      "status": "stable"
    },
    {
      "name": "Capabilities",
      "locations": [
        "envelope"
      ],
      "group": "Capability Negotiation Headers",
      "direction": "request",
      "format": "Comma-separated",
      "description": "Client's capability groups",
      "section": "14.4",
      "since": "0.1.0",
      "status": "stable"
    },
    {

{
  "$id": "https://github.com/CatlystAI/agent-mesh-protocol/spec/registry/headers.json",
  "registry": "headers",
  "description": "AMP envelope headers (WIRE-BINDING section 14) and the HTTP header fields the binding uses. Receivers MUST ignore headers they do not understand.",
